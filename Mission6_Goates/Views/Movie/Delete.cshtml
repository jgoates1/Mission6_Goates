@model Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<div class="container mt-4 text-center">
    <h2 class="text-danger">Confirm Deletion</h2>
    
    <h3>Are you sure you want to delete <strong>@Model.Title</strong> from Joel's collection?</h3>
    <p>This action cannot be undone.</p>

    <form asp-action="Delete" method="post">
        
        <input type="hidden" asp-for="MovieId" />

        <button type="submit" class="btn btn-danger">Yes, Delete It</button>
        
        <a asp-controller="Movie" asp-action="MovieList" class="btn btn-secondary">Cancel</a>
    </form>
</div>