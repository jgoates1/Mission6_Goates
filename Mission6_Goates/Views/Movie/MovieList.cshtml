@model List<Mission6_Goates.Models.Movie>

@{
    ViewData["Title"] = "Joel's Movie Collection";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Year</th>
            <th>Category</th>
            <th>Director</th>
            <th>Rating</th>
            <th>Edited</th>
            <th>Lent To</th>
            <th>Plex</th>
            <th>Notes</th>
            <th>Actions</th> </tr>
        </thead>
        <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.Title</td>
                <td>@x.Year</td>
                <td>@x.Category?.CategoryName</td>
                <td>@x.Director</td>
                <td>@x.Rating</td>
                <td>@(x.Edited == true ? "Yes" : "No")</td>
                <td>@x.LentTo</td>
                <td>@(x.CopiedToPlex ? "Yes" : "No")</td>
                <td>@x.Notes</td>
                <td>
                    <a asp-controller="Movie" asp-action="Edit" asp-route-id="@x.MovieId" class="btn btn-info btn-sm">Edit</a>
                    <a asp-controller="Movie" asp-action="Delete" asp-route-id="@x.MovieId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>